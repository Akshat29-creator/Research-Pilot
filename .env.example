# Project Configuration
PROJECT_NAME="ResearchPilot AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Authentication
JWT_SECRET_KEY=change-this-in-production-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchpilot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/researchpilot

# Redis Configuration (Queue & Cache)
REDIS_URL=redis://localhost:6379/0

# Ollama LLM Configuration (Host machine)
# When running inside Docker, use http://host.docker.internal:11434
# When running directly on host, use http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
PRIMARY_MODEL=qwen3:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_CONTEXT_WINDOW=4096
VRAM_WARN_THRESHOLD_MB=5500

# Search Provider Configuration
# Options: searxng (default, free), tavily, brave
SEARCH_PROVIDER=searxng
SEARXNG_BASE_URL=http://localhost:8080
TAVILY_API_KEY=
BRAVE_API_KEY=

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
